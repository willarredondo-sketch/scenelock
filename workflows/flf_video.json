{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{START_FRAME_IMAGE}}"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{END_FRAME_IMAGE}}"
    }
  },
  "3": {
    "class_type": "ByteDanceFirstLastFrameNode",
    "inputs": {
      "model": "{{VIDEO_MODEL}}",
      "prompt": "{{VIDEO_PROMPT}}",
      "first_frame": ["1", 0],
      "last_frame": ["2", 0],
      "resolution": "{{VIDEO_RESOLUTION}}",
      "aspect_ratio": "{{ASPECT_RATIO}}",
      "duration": "{{DURATION}}",
      "seed": "{{SEED}}",
      "camera_fixed": true,
      "watermark": false,
      "generate_audio": false
    }
  },
  "4": {
    "class_type": "SaveVideo",
    "inputs": {
      "filename_prefix": "{{FILENAME_PREFIX}}",
      "format": "mp4",
      "codec": "auto",
      "video": ["3", 0]
    }
  }
}
