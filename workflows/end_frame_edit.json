{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{START_FRAME_IMAGE}}"
    }
  },
  "2": {
    "class_type": "GeminiImage2Node",
    "inputs": {
      "prompt": "{{END_PROMPT}}",
      "model": "{{IMAGE_MODEL}}",
